# =====================================================================
# AQ.Denials — environment. Copy to `.env` before `docker compose up`:
#
#     cp .env.example .env
#
# Every value below is read from the environment only. Nothing in the
# repository contains a password, a token or a provider key.
# =====================================================================

# ---- database -------------------------------------------------------
# Compose starts the container; these are what the API connects with.
POSTGRES_USER=denials
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=denials

# Full ADO.NET connection string the API uses. Leave `db` as the host —
# that is the compose service name. Override only to point elsewhere.
ConnectionStrings__Denials=Host=db;Port=5432;Database=denials;Username=denials;Password=change-me-local-only

# ---- data pack ------------------------------------------------------
# Absolute or relative path to the unzipped assignment data pack.
# docker-compose mounts this into the container at /data, read-only.
#
# On Linux/macOS inside compose this MUST be a path compose can see.
# Windows: point it at your own unzip location, e.g.
#     DATA_DIR=C:/Users/you/Downloads/AQSoft_Assignment_Data_Pack_1
DATA_DIR=./AQSoft_Assignment_Data_Pack_1

# ---- seeded identities ----------------------------------------------
# JSON array. Tokens must be >= 16 characters; roles are `reader` (may read
# reconciliation, exceptions, claims, audit) or `ingest` (may also POST
# /api/ingest). The API REFUSES TO START outside Development if this is
# unset — there is deliberately no permissive default in code.
#
# The values below are for local evaluation only. Replace them before any
# deployment that is reachable by anyone else.
SEED_USERS=[{"token":"local-reader-token-0000000000","name":"reader","role":"reader"},{"token":"local-ingest-token-0000000000","name":"ops","role":"ingest"}]

# ---- migrations -----------------------------------------------------
# `true` (default) runs `dotnet ef database update` equivalent on startup.
# Set to `false` if you migrate out of band in CI.
AUTOMIGRATE=true

# ---- port -----------------------------------------------------------
API_PORT=8080

# ---- LLM (Phase 2+; not used in Phase 1) ----------------------------
# No provider is configured by default and the API starts anyway: the
# NullLlmClient refuses to answer rather than inventing an answer.
# When you do configure one, set BOTH of these. The key is read only from
# the environment; it is never written to source, logs or the database.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
