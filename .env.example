# =====================================================================
# AQ.Denials — environment. Copy to `.env` before `docker compose up`:
#
#     cp .env.example .env
#
# Every value below is read from the environment only. Nothing in the
# repository contains a password, a token or a provider key.
# =====================================================================

# ---- database -------------------------------------------------------
# Compose starts the container; these are what the API connects with.
POSTGRES_USER=denials
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=denials

# Full ADO.NET connection string the API uses. Leave `db` as the host —
# that is the compose service name. Override only to point elsewhere.
ConnectionStrings__Denials=Host=db;Port=5432;Database=denials;Username=denials;Password=change-me-local-only

# ---- data pack ------------------------------------------------------
# Absolute or relative path to the unzipped assignment data pack.
# docker-compose mounts this into the container at /data, read-only.
#
# On Linux/macOS inside compose this MUST be a path compose can see.
# Windows: point it at your own unzip location, e.g.
#     DATA_DIR=C:/Users/you/Downloads/AQSoft_Assignment_Data_Pack_1
DATA_DIR=./AQSoft_Assignment_Data_Pack_1

# ---- seeded identities ----------------------------------------------
# JSON array. Tokens must be >= 16 characters. Four roles:
#
#   reader      read reconciliation, exceptions, claims, audit
#   ingest      the above, plus POST /api/ingest
#   specialist  the worklist: own queue, status and notes
#   manager     the whole worklist: reassign, review, bulk drafting
#
# The API REFUSES TO START outside Development if this is unset, or if
# either worklist role is missing — there is deliberately no permissive
# default in code, and a config that seeds only one of the two roles the
# product defines would fail at the first click instead.
#
# The values below are for local evaluation only. Replace them before any
# deployment that is reachable by anyone else.
SEED_USERS=[{"token":"local-reader-token-0000000000","name":"reader","role":"reader"},{"token":"local-ingest-token-0000000000","name":"ops","role":"ingest"},{"token":"local-specialist-token-0000000","name":"Dana (specialist)","role":"specialist"},{"token":"local-manager-token-0000000000","name":"Priya (manager)","role":"manager"}]

# ---- migrations -----------------------------------------------------
# `true` (default) runs `dotnet ef database update` equivalent on startup.
# Set to `false` if you migrate out of band in CI.
AUTOMIGRATE=true

# ---- port -----------------------------------------------------------
API_PORT=8080
# The web console (nginx inside the container). Open http://localhost:5173
WEB_PORT=5173

# ---- LLM (Phase 2) --------------------------------------------------
# Nothing is configured by default and the API starts anyway: the
# NullLlmClient refuses to answer rather than inventing an answer, and the
# whole analysis — category, team, preventability, next action, window,
# confidence, priority — is computed without a model. Only draft appeals
# are affected.
#
# The supported wire format is OpenAI-compatible chat completions
# (OpenAI, Ollama, vLLM, and Gemini gateways that expose it). The
# Anthropic Messages API is NOT implemented — see docs/DECISIONS.md D29.
#
#   LLM_PROVIDER   e.g. `ollama` or `openai`. Empty = degraded mode.
#   LLM_BASE_URL   optional override of the provider's default base URL,
#                  e.g. http://host.docker.internal:11434/v1 for an Ollama
#                  running outside the compose network.
#   LLM_API_KEY    read only from the environment. Never written to
#                  source, logs or the database, and never sent in a
#                  prompt.
#   LLM_MODEL      e.g. qwen2.5:7b-instruct
#   LLM_TIMEOUT_SECONDS  optional, default 60
#
# LLM_PROVIDER set but unreachable FAILS AT STARTUP rather than starting
# and silently producing no drafts for a week.
LLM_PROVIDER=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=
