# build output
bin/
obj/
dist/
build/
node_modules/
web/dist/
eval/results.json

# secrets & local config — never commit
.env
*.pfx
*.key

# ---------------------------------------------------------------------------
# D14 / D15 — the assignment data pack is an INPUT, not source.
# It sits in the repo working tree so the default DATA_DIR resolves, but it is
# never tracked: claims carry patient identifiers and the 835s carry claim-level
# payment detail. Reviewers supply their own copy (see README.md).
#
# `/*` rather than a trailing slash: git cannot re-include a file whose parent
# directory is excluded, so the directory itself must stay open for the four
# reference files below to be reachable. Everything else in the pack is still
# excluded by this same pattern, and `*.835` / `*_extracted.csv` /
# `denials_worklog*.xlsx` exclude them wherever they appear.
# ---------------------------------------------------------------------------
AQSoft_Assignment_Data_Pack_1/*

# ...with exactly four exceptions (D24): pure reference data, no person in them.
# These are committed so the rules, code meanings and payer policies that the
# system reasons from are reviewable without unzipping anything. They do NOT
# make the test suite runnable standalone — claims_export.csv and the remits
# remain excluded and always will be.
!AQSoft_Assignment_Data_Pack_1/payer_rules.csv
!AQSoft_Assignment_Data_Pack_1/carc_rarc_reference.csv
!AQSoft_Assignment_Data_Pack_1/claim_adjustment_group_codes.csv
!AQSoft_Assignment_Data_Pack_1/payer_policies/

# data pack, wherever DATA_DIR points (reviewer's own unzip location)
/data/
*.835
denials_worklog*.xlsx

# The pack's PHI-carrying inputs, ignored BY FILE NAME wherever they appear —
# DATA_DIR can point anywhere, and a reviewer who unzips to another folder must
# not be able to commit this by accident.
# `*.xlsx` is deliberately broad: an xlsx is binary, so phi_guard's R3 name check
# cannot read it, and a *renamed* worklog would slip past R1's specific pattern.
# If a future phase genuinely needs to commit a spreadsheet, `git add -f` it and
# expect to justify it — that friction is the point.
claims_export.csv
*.xlsx

# generated extracts containing patient identifiers
# (rebuild with: powershell -File tools/extract_worklog.ps1)
worklog_extracted.csv
*_extracted.csv

# tool scratch output
tools/*.json
!tools/*.mjs
*.log

# editor / OS
.vs/
.vscode/
.idea/
Thumbs.db
.DS_Store
